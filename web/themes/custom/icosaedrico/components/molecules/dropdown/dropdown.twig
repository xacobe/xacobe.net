{% set wrapper_classes = [
  'dropdown',
  position_x ? 'dropdown-' ~ position_x,
  position_y ? 'dropdown-' ~ position_y,
  hover ? 'dropdown-hover',
] %}

{% if details_tag %}
  <details {{ attributes.addClass(wrapper_classes) }}>
    <summary class="btn btn-sm btn-ghost">{{ title }}</summary>
    <ul class="dropdown-content">
      {{ slots.dropdown_content }}
    </ul>
  </details>
{% else %}
  <div {{ attributes.addClass(wrapper_classes) }}>
    <div tabindex="0" role="button" class="btn btn-sm btn-ghost">{{ title }}</div>
    <ul class="dropdown-content">
      {{ slots.dropdown_content }}
    </ul>
  </div>
{% endif %}
