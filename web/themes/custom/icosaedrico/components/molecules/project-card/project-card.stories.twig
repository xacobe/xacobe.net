{% set icon_base = '/themes/custom/icosaedrico/img/icons/' %}

{% set placeholder_desktop %}
  <div style="background:#e8e8e8;width:100%;aspect-ratio:16/9;display:flex;align-items:center;justify-content:center;">
    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="#aaa" viewBox="0 0 16 16">
      <path d="M6.002 5.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z"/>
      <path d="M2.002 1a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2h-12zm12 1a1 1 0 0 1 1 1v6.5l-3.777-1.947a.5.5 0 0 0-.577.093l-3.71 3.71-2.66-1.772a.5.5 0 0 0-.63.062L1.002 12V3a1 1 0 0 1 1-1h12z"/>
    </svg>
  </div>
{% endset %}

{% set placeholder_mobile %}
  <div style="background:#e8e8e8;width:100%;aspect-ratio:9/16;display:flex;align-items:center;justify-content:center;">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="#aaa" viewBox="0 0 16 16">
      <path d="M6.002 5.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z"/>
      <path d="M2.002 1a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2h-12zm12 1a1 1 0 0 1 1 1v6.5l-3.777-1.947a.5.5 0 0 0-.577.093l-3.71 3.71-2.66-1.772a.5.5 0 0 0-.63.062L1.002 12V3a1 1 0 0 1 1-1h12z"/>
    </svg>
  </div>
{% endset %}

{% macro render(title, url, project_url, project_url_title, tech_icons, screenshot_desktop, screenshot_mobile) %}
  {{ include('icosaedrico:project-card', {
    title: title,
    url: url,
    project_url: project_url,
    project_url_title: project_url_title,
    tech_icons: tech_icons,
    slots: {
      screenshot_desktop: screenshot_desktop,
      screenshot_mobile: screenshot_mobile,
    },
  }, with_context = false) }}
{% endmacro %}

{% stories project_card with {
  title: 'Molecules/Project Card',
  description: 'Tarjeta de proyecto con columna de información (título, tecnologías, enlace externo) y marcos de dispositivo para capturas de pantalla. Las capturas se inyectan como slots desde Drupal.',
  tags: ['autodocs'],
  args: {
    title: 'xacobe.net',
    url: '#',
    project_url: 'https://xacobe.net',
    project_url_title: 'Ver proyecto',
    tech_icons: [
      { src: '/themes/custom/icosaedrico/img/icons/drupal_color.svg', label: 'Drupal' },
      { src: '/themes/custom/icosaedrico/img/icons/filetype-php.svg',  label: 'PHP' },
      { src: '/themes/custom/icosaedrico/img/icons/css_color.svg',     label: 'CSS' },
      { src: '/themes/custom/icosaedrico/img/icons/js_color.svg',      label: 'JS' },
    ],
  },
  argTypes: {
    title: {
      description: 'Nombre del proyecto.',
      control: { type: 'text' },
      table: { type: { summary: 'string' } }
    },
    url: {
      description: 'URL interna del nodo.',
      control: { type: 'text' },
      table: { type: { summary: 'string' }, defaultValue: { summary: '-' } }
    },
    project_url: {
      description: 'URL externa del proyecto en producción.',
      control: { type: 'text' },
      table: { type: { summary: 'string' }, defaultValue: { summary: '-' } }
    },
    project_url_title: {
      description: 'Texto del enlace externo.',
      control: { type: 'text' },
      table: { type: { summary: 'string' }, defaultValue: { summary: 'project_url' } }
    },
    tech_icons: {
      description: 'Array de objetos `{ src, label }` por tecnología.',
      control: { type: 'object' },
      table: { type: { summary: 'Array<{ src: string, label: string }>' } }
    }
  }
} %}

  {% story default with {
    name: 'Default',
    description: 'Tarjeta completa con iconos de tecnología y placeholders de captura de pantalla.',
    args: {
      title: 'xacobe.net',
      url: '#',
      project_url: 'https://xacobe.net',
      project_url_title: 'Ver proyecto',
      tech_icons: [
        { src: '/themes/custom/icosaedrico/img/icons/drupal_color.svg', label: 'Drupal' },
        { src: '/themes/custom/icosaedrico/img/icons/filetype-php.svg',  label: 'PHP' },
        { src: '/themes/custom/icosaedrico/img/icons/css_color.svg',     label: 'CSS' },
        { src: '/themes/custom/icosaedrico/img/icons/js_color.svg',      label: 'JS' },
      ],
    }
  } %}
    {{ _self.render(title, url, project_url, project_url_title, tech_icons, placeholder_desktop, placeholder_mobile) }}
  {% endstory %}

  {% story no_link with {
    name: 'Sin enlace externo',
    tags: ['!autodocs'],
    description: 'Sin project_url — el botón no se renderiza.',
    args: {
      title: 'Proyecto interno',
      url: '#',
      project_url: '',
      project_url_title: '',
      tech_icons: [
        { src: '/themes/custom/icosaedrico/img/icons/drupal_color.svg', label: 'Drupal' },
        { src: '/themes/custom/icosaedrico/img/icons/filetype-php.svg',  label: 'PHP' },
      ],
    }
  } %}
    {{ _self.render(title, url, project_url, project_url_title, tech_icons, placeholder_desktop, placeholder_mobile) }}
  {% endstory %}

  {% story no_node_url with {
    name: 'Sin enlace al nodo',
    tags: ['!autodocs'],
    description: 'El título se muestra como texto plano sin enlace.',
    args: {
      title: 'Prototipo sin publicar',
      url: '',
      project_url: 'https://example.com',
      project_url_title: 'Demo',
      tech_icons: [
        { src: '/themes/custom/icosaedrico/img/icons/js_color.svg',     label: 'JavaScript' },
        { src: '/themes/custom/icosaedrico/img/icons/filetype-jsx.svg', label: 'React' },
      ],
    }
  } %}
    {{ _self.render(title, url, project_url, project_url_title, tech_icons, placeholder_desktop, placeholder_mobile) }}
  {% endstory %}

{% endstories %}
