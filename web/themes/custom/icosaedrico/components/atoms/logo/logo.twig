{% set classes = [
  'logo',
  logo_size ? 'logo--' ~ logo_size,
] %}

{% if logo_href %}
  <a href="{{ logo_href }}" {% if attributes %}{{ attributes.addClass(classes) }}{% else %}class="{{ classes|join(' ')|trim }}"{% endif %} rel="home">
    <img src="{{ logo_src }}" alt="{{ logo_alt|default('Home') }}">
  </a>
{% else %}
  <div {% if attributes %}{{ attributes.addClass(classes) }}{% else %}class="{{ classes|join(' ')|trim }}"{% endif %}>
    <img src="{{ logo_src }}" alt="{{ logo_alt|default('Home') }}">
  </div>
{% endif %}
