{% macro render(button_text, button_tag, button_href, button_color, button_size, button_outline, button_glass, button_shape, button_disable, button_icon) %}
  {{ include('icosaedrico:button', {
    button_text: button_text,
    button_tag: button_tag,
    button_href: button_href,
    button_color: button_color,
    button_size: button_size,
    button_outline: button_outline,
    button_glass: button_glass,
    button_shape: button_shape,
    button_disable: button_disable,
    button_icon: button_icon,
  }, with_context = false) }}
{% endmacro %}

{% stories button with {
  title: 'Atoms/Button',
  description: 'Botón reutilizable. Soporta etiqueta `<a>` o `<button>`, colores, tamaños, variante outline y con icono.',
  tags: ['autodocs'],
  args: {
    button_text: 'Botón',
    button_tag: 'a',
    button_href: '#',
    button_color: 'primary',
    button_size: '',
    button_outline: false,
    button_glass: false,
    button_shape: '',
    button_disable: '',
    button_icon: '',
  },
  argTypes: {
    button_text: {
      description: 'Texto visible del botón.',
      control: { type: 'text' },
      table: { type: { summary: 'string' }, defaultValue: { summary: 'Botón' } }
    },
    button_tag: {
      description: 'Etiqueta HTML a usar.',
      control: { type: 'radio' },
      options: ['a', 'button'],
      table: { type: { summary: 'a | button' }, defaultValue: { summary: 'a' } }
    },
    button_href: {
      description: 'Destino del enlace (solo si tag es `a`).',
      control: { type: 'text' },
      table: { type: { summary: 'string' }, defaultValue: { summary: '#' } }
    },
    button_color: {
      description: 'Variante de color.',
      control: { type: 'select' },
      options: ['primary', 'secondary', 'link', ''],
      table: { type: { summary: 'primary | secondary | link' }, defaultValue: { summary: 'primary' } }
    },
    button_size: {
      description: 'Tamaño del botón.',
      control: { type: 'select' },
      options: ['', 'lg', 'sm', 'xs', 'wide', 'block'],
      table: { type: { summary: 'lg | sm | xs | wide | block' }, defaultValue: { summary: '-' } }
    },
    button_outline: {
      description: 'Variante con borde y fondo transparente.',
      control: { type: 'boolean' },
      table: { type: { summary: 'boolean' }, defaultValue: { summary: 'false' } }
    },
    button_glass: {
      description: 'Efecto de cristal en el fondo.',
      control: { type: 'boolean' },
      table: { type: { summary: 'boolean' }, defaultValue: { summary: 'false' } }
    },
    button_shape: {
      description: 'Forma geométrica del botón.',
      control: { type: 'select' },
      options: ['', 'square', 'circle'],
      table: { type: { summary: 'square | circle' }, defaultValue: { summary: '-' } }
    },
    button_disable: {
      description: 'Desactiva el botón via clase CSS o atributo HTML.',
      control: { type: 'radio' },
      options: ['', 'class', 'attribute'],
      table: { type: { summary: 'class | attribute' }, defaultValue: { summary: '-' } }
    },
    button_icon: {
      description: 'Nombre del icono SVG (sin extensión) de `img/icons/`.',
      control: { type: 'text' },
      table: { type: { summary: 'string' }, defaultValue: { summary: '-' } }
    }
  }
} %}

  {% story primary with {
    name: 'Primary',
    description: 'Botón principal de acción.',
    args: { button_text: 'Ver proyecto', button_tag: 'a', button_href: '#', button_color: 'primary' },
    parameters: { docs: { source: { code: "{{ include('icosaedrico:button', {\n  button_text: 'Ver proyecto',\n  button_tag: 'a',\n  button_href: '#',\n  button_color: 'primary',\n}, with_context = false) }}" } } }
  } %}
    {{ _self.render(button_text, button_tag, button_href, button_color, button_size, button_outline, button_glass, button_shape, button_disable, button_icon) }}
  {% endstory %}

  {% story secondary with {
    name: 'Secondary',
    tags: ['!autodocs'],
    description: 'Botón secundario.',
    args: { button_text: 'Cancelar', button_tag: 'button', button_href: '', button_color: 'secondary' },
    parameters: { docs: { source: { code: "{{ include('icosaedrico:button', {\n  button_text: 'Cancelar',\n  button_tag: 'button',\n  button_color: 'secondary',\n}, with_context = false) }}" } } }
  } %}
    {{ _self.render(button_text, button_tag, button_href, button_color, button_size, button_outline, button_glass, button_shape, button_disable, button_icon) }}
  {% endstory %}

  {% story outline with {
    name: 'Outline',
    tags: ['!autodocs'],
    description: 'Variante con borde y fondo transparente.',
    args: { button_text: 'Saber más', button_tag: 'a', button_href: '#', button_color: 'primary', button_outline: true },
    parameters: { docs: { source: { code: "{{ include('icosaedrico:button', {\n  button_text: 'Saber más',\n  button_tag: 'a',\n  button_href: '#',\n  button_color: 'primary',\n  button_outline: true,\n}, with_context = false) }}" } } }
  } %}
    {{ _self.render(button_text, button_tag, button_href, button_color, button_size, button_outline, button_glass, button_shape, button_disable, button_icon) }}
  {% endstory %}

  {% story sizes with {
    name: 'Sizes',
    tags: ['!autodocs'],
    description: 'Comparativa de tamaños: lg, default, sm, xs.',
    args: { button_text: 'Botón lg', button_tag: 'a', button_href: '#', button_color: 'primary', button_size: 'lg' },
    parameters: { docs: { source: { code: "{{ include('icosaedrico:button', {\n  button_text: 'Botón',\n  button_tag: 'a',\n  button_href: '#',\n  button_color: 'primary',\n  button_size: 'lg', {# lg | sm | xs #}\n}, with_context = false) }}" } } }
  } %}
    {{ _self.render(button_text, button_tag, button_href, button_color, button_size, button_outline, button_glass, button_shape, button_disable, button_icon) }}
  {% endstory %}

  {% story disabled with {
    name: 'Disabled',
    tags: ['!autodocs'],
    description: 'Botón desactivado mediante clase CSS.',
    args: { button_text: 'No disponible', button_tag: 'button', button_href: '', button_color: 'primary', button_disable: 'class' },
    parameters: { docs: { source: { code: "{{ include('icosaedrico:button', {\n  button_text: 'No disponible',\n  button_tag: 'button',\n  button_color: 'primary',\n  button_disable: 'class', {# class | attribute #}\n}, with_context = false) }}" } } }
  } %}
    {{ _self.render(button_text, button_tag, button_href, button_color, button_size, button_outline, button_glass, button_shape, button_disable, button_icon) }}
  {% endstory %}

  {% story gallery with {
    name: 'Gallery',
    description: 'Todas las variantes del componente botón en una sola vista.',
    parameters: { docs: { canvas: { sourceState: 'none' } } },
  } %}
    {% set btn = 'icosaedrico:button' %}

    <div style="display: flex; flex-direction: column; gap: 2rem; padding: 1.5rem;">

      <div>
        <p style="font-size: .7rem; font-weight: 600; text-transform: uppercase; letter-spacing: .1em; margin-bottom: .75rem;">Colores</p>
        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: .75rem;">
          {{ include(btn, { button_text: 'Primary', button_tag: 'a', button_href: '#', button_color: 'primary' }, with_context = false) }}
          {{ include(btn, { button_text: 'Secondary', button_tag: 'a', button_href: '#', button_color: 'secondary' }, with_context = false) }}
          {{ include(btn, { button_text: 'Link', button_tag: 'a', button_href: '#', button_color: 'link' }, with_context = false) }}
        </div>
      </div>

      <div>
        <p style="font-size: .7rem; font-weight: 600; text-transform: uppercase; letter-spacing: .1em; margin-bottom: .75rem;">Outline</p>
        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: .75rem;">
          {{ include(btn, { button_text: 'Primary', button_tag: 'a', button_href: '#', button_color: 'primary', button_outline: true }, with_context = false) }}
          {{ include(btn, { button_text: 'Secondary', button_tag: 'a', button_href: '#', button_color: 'secondary', button_outline: true }, with_context = false) }}
        </div>
      </div>

      <div>
        <p style="font-size: .7rem; font-weight: 600; text-transform: uppercase; letter-spacing: .1em; margin-bottom: .75rem;">Tamaños</p>
        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: .75rem;">
          {{ include(btn, { button_text: 'Large', button_tag: 'a', button_href: '#', button_color: 'primary', button_size: 'lg' }, with_context = false) }}
          {{ include(btn, { button_text: 'Default', button_tag: 'a', button_href: '#', button_color: 'primary' }, with_context = false) }}
          {{ include(btn, { button_text: 'Small', button_tag: 'a', button_href: '#', button_color: 'primary', button_size: 'sm' }, with_context = false) }}
          {{ include(btn, { button_text: 'XSmall', button_tag: 'a', button_href: '#', button_color: 'primary', button_size: 'xs' }, with_context = false) }}
        </div>
      </div>

      <div>
        <p style="font-size: .7rem; font-weight: 600; text-transform: uppercase; letter-spacing: .1em; margin-bottom: .75rem;">Disabled</p>
        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: .75rem;">
          {{ include(btn, { button_text: 'Via clase', button_tag: 'button', button_color: 'primary', button_disable: 'class' }, with_context = false) }}
          {{ include(btn, { button_text: 'Via atributo', button_tag: 'button', button_color: 'primary', button_disable: 'attribute' }, with_context = false) }}
        </div>
      </div>

    </div>
  {% endstory %}

{% endstories %}
