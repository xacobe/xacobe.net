{% set classes = [
  "page-title",
  title_type ? "page-title--" ~ title_type,
  title_classes,
] %}

{% set title_tag = title_tag|default('h1') %}

{% if title_type == 'prose' %}
  <{{ title_tag }}{% if attributes %} {{ attributes }}{% endif %} class="{{ classes|join(' ')|trim }}">
    {{ title }}
  </{{ title_tag }}>
{% else %}
  <div class="flex w-full flex-col border-opacity-50">
    <div class="divider">
      <{{ title_tag }}{% if attributes %} {{ attributes }}{% endif %} class="{{ classes|join(' ')|trim }}">
        {{ title }}
      </{{ title_tag }}>
    </div>
  </div>
{% endif %}

