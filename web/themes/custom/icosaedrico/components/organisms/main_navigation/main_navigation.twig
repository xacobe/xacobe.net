{% block content %}
  {% import _self as menus %}
  {{ menus.menu_links(items, attributes, 0, menu_level_0_classes|default('main-menu')) }}

  {% macro menu_links(items, attributes, menu_level, menu_level_0_classes) %}
    {% import _self as menus %}
    {% if items %}
      {% set list_class = menu_level == 0 ? menu_level_0_classes : 'nav-menu' %}
      <ul {{ attributes.addClass(list_class) }}>
        {% for item in items %}

          {%- set url_attributes = item.url.getOption('attributes')|default({}) -%}
          {%- set icon      = url_attributes['data-icon']|default('') -%}
          {%- set icon_only = url_attributes['data-icon-show']|default('') == 'true' -%}
          {%- set active    = item.in_active_trail ? 'is-active' : '' -%}

          <li {{ item.attributes|default(create_attribute())|without('data-icon', 'data-icon-show') }}>

            {% if icon and icon_only %}
              {# Icon-only link — visually just the icon, title as aria-label #}
              <a href="{{ item.url }}" class="menu-link menu-link--icon-only {{ active }}" aria-label="{{ item.title }}">
                {% include "icosaedrico:icon" with {
                  icon_name: icon,
                  icon_svg_size: "16",
                  icon_svg_fill: active ? "currentColor" : "var(--color-text-muted)",
                } only %}
              </a>

            {% elseif icon %}
              {# Icon + label link #}
              <a href="{{ item.url }}" class="menu-link menu-link--has-icon {{ active }}">
                {% include "icosaedrico:icon" with {
                  icon_name: icon,
                  icon_svg_size: "16",
                  icon_svg_fill: active ? "currentColor" : "var(--color-text-muted)",
                } only %}
                <span class="menu-label">{{ item.title }}</span>
              </a>

            {% else %}
              {# Text-only link #}
              <a href="{{ item.url }}" class="menu-link {{ active }}">
                {{ item.title }}
              </a>
            {% endif %}

            {% if item.below %}
              {{ menus.menu_links(item.below, attributes, menu_level + 1, menu_level_0_classes) }}
            {% endif %}

          </li>
        {% endfor %}
      </ul>
    {% endif %}
  {% endmacro %}
{% endblock %}
