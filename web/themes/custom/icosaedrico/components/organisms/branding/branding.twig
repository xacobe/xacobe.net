{% set branding_classes = [
  "branding",
  branding_layout ? "branding--" ~ branding_layout : "branding--horizontal",
  branding_size ? "branding--" ~ branding_size,
] %}

<div {{ attributes.addClass(branding_classes|safe_join(' ')) }}>
  {{ title_prefix }}
  {% if label %}
    <h2 {{ title_attributes }}>{{ label }}</h2>
  {% endif %}
  {{ title_suffix }}
  {% block content %}
  {% if site_logo and branding_show_logo != false %}
    {{ include('icosaedrico:logo', {
      logo_src: site_logo,
      logo_alt: 'Home'|t,
      logo_href: path('<front>'),
      logo_size: branding_size,
    }, with_context = false) }}
  {% endif %}
  <div class="branding__text">
    {% if site_name %}
    <div class="branding__title">
      <a href="{{ path('<front>') }}" rel="home">xacobe.<span class="branding__title--suffix">net</span></a>
    </div>
    {% endif %}
    {% if branding_show_slogan != false %}
    <div class="branding__slogan">
      <span class="branding__slogan--text">{{ site_slogan }}</span>
    </div>
    {% endif %}
  </div>
  {% endblock %}
</div>
