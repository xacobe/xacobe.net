{% macro render(branding_layout, branding_size, branding_show_logo, branding_show_slogan, site_logo, site_name, site_slogan) %}
  {{ include('icosaedrico:branding', {
    branding_layout: branding_layout,
    branding_size: branding_size,
    branding_show_logo: branding_show_logo,
    branding_show_slogan: branding_show_slogan,
    site_logo: site_logo,
    site_name: site_name,
    site_slogan: site_slogan,
  }, with_context = false) }}
{% endmacro %}

{% stories branding with {
  title: 'Organisms/Branding',
  description: 'Logo, nombre y eslogan del sitio. Soporta layouts horizontal/vertical y tamaños sm, md, lg, xl.',
  tags: ['autodocs'],
  args: {
    branding_layout: 'horizontal',
    branding_size: 'md',
    branding_show_logo: true,
    branding_show_slogan: true,
    site_logo: 'http://xacobe.net.ddev.site/themes/custom/icosaedrico/logo.svg',
    site_name: 'xacobe.net',
    site_slogan: 'Diseño & desarrollo web'
  },
  argTypes: {
    branding_layout: {
      description: 'Disposición del logo y el texto: horizontal (lado a lado) o vertical (apilados).',
      control: { type: 'radio' },
      options: ['horizontal', 'vertical'],
      table: {
        type: { summary: 'horizontal | vertical' },
        defaultValue: { summary: 'horizontal' }
      }
    },
    branding_size: {
      description: 'Escala del logo y el título del sitio.',
      control: { type: 'select' },
      options: ['sm', 'md', 'lg', 'xl'],
      table: {
        type: { summary: 'sm | md | lg | xl' },
        defaultValue: { summary: 'md' }
      }
    },
    branding_show_logo: {
      description: 'Muestra u oculta la imagen del logo.',
      control: { type: 'boolean' },
      table: {
        type: { summary: 'boolean' },
        defaultValue: { summary: 'true' }
      }
    },
    branding_show_slogan: {
      description: 'Muestra u oculta el eslogan del sitio.',
      control: { type: 'boolean' },
      table: {
        type: { summary: 'boolean' },
        defaultValue: { summary: 'true' }
      }
    },
    site_logo: {
      description: 'URL de la imagen del logo.',
      control: { type: 'text' },
      table: {
        type: { summary: 'string' },
        defaultValue: { summary: '-' }
      }
    },
    site_name: {
      description: 'Nombre del sitio.',
      control: { type: 'text' },
      table: {
        type: { summary: 'string' },
        defaultValue: { summary: '-' }
      }
    },
    site_slogan: {
      description: 'Eslogan del sitio.',
      control: { type: 'text' },
      table: {
        type: { summary: 'string' },
        defaultValue: { summary: '-' }
      }
    }
  }
} %}

  {% story header with {
    name: 'Header (sm)',
    description: 'Versión compacta para header. Logo y nombre sin eslogan.',
    args: { branding_layout: 'horizontal', branding_size: 'sm', branding_show_logo: true, branding_show_slogan: false, site_logo: 'http://xacobe.net.ddev.site/themes/custom/icosaedrico/logo.svg', site_name: 'xacobe.net', site_slogan: 'Diseño & desarrollo web' }
  } %}
    {{ _self.render(branding_layout, branding_size, branding_show_logo, branding_show_slogan, site_logo, site_name, site_slogan) }}
  {% endstory %}

  {% story horizontal with {
    name: 'Horizontal (md)',
    tags: ['!autodocs'],
    description: 'Layout horizontal con logo, nombre y eslogan.',
    args: { branding_layout: 'horizontal', branding_size: 'md', branding_show_logo: true, branding_show_slogan: true, site_logo: 'http://xacobe.net.ddev.site/themes/custom/icosaedrico/logo.svg', site_name: 'xacobe.net', site_slogan: 'Diseño & desarrollo web' }
  } %}
    {{ _self.render(branding_layout, branding_size, branding_show_logo, branding_show_slogan, site_logo, site_name, site_slogan) }}
  {% endstory %}

  {% story vertical with {
    name: 'Vertical (md)',
    tags: ['!autodocs'],
    description: 'Layout vertical con todos los elementos.',
    args: { branding_layout: 'vertical', branding_size: 'md', branding_show_logo: true, branding_show_slogan: true, site_logo: 'http://xacobe.net.ddev.site/themes/custom/icosaedrico/logo.svg', site_name: 'xacobe.net', site_slogan: 'Diseño & desarrollo web' }
  } %}
    {{ _self.render(branding_layout, branding_size, branding_show_logo, branding_show_slogan, site_logo, site_name, site_slogan) }}
  {% endstory %}

  {% story hero with {
    name: 'Hero frontpage (xl)',
    tags: ['!autodocs'],
    description: 'Versión grande para el hero de la portada.',
    args: { branding_layout: 'vertical', branding_size: 'xl', branding_show_logo: true, branding_show_slogan: true, site_logo: 'http://xacobe.net.ddev.site/themes/custom/icosaedrico/logo.svg', site_name: 'xacobe.net', site_slogan: 'Diseño & desarrollo web' }
  } %}
    {{ _self.render(branding_layout, branding_size, branding_show_logo, branding_show_slogan, site_logo, site_name, site_slogan) }}
  {% endstory %}

{% endstories %}
