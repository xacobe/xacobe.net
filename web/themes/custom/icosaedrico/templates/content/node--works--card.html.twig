{%- set tech_icons = [] -%}
{%- for item in node.field_project_tech -%}
  {%- set term = item.entity -%}
  {%- set icon_name = term.field_tech_icon.value -%}
  {%- if icon_name -%}
    {%- set icon_src = base_path ~ active_theme_path() ~ '/img/icons/' ~ icon_name ~ '.svg' -%}
    {%- set tech_icons = tech_icons|merge([{ src: icon_src, label: term.label }]) -%}
  {%- endif -%}
{%- endfor -%}

{% embed 'icosaedrico:project-card' with {
  title: label,
  url: url,
  project_url: node.field_project_url.uri,
  project_url_title: node.field_project_url.title,
  tech_icons: tech_icons,
  attributes: attributes,
  title_prefix: title_prefix,
  title_suffix: title_suffix,
  title_attributes: title_attributes,
} %}
  {% block screenshot_desktop %}{{ content.field_screenshot_desktop }}{% endblock %}
  {% block screenshot_mobile %}{{ content.field_screenshot_mobile }}{% endblock %}
{% endembed %}
