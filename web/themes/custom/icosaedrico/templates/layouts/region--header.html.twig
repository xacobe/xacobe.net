{#
/**
 * @file
 * Theme override to display a region.
 *
 * Available variables:
 * - content: The content for this region, typically blocks.
 * - attributes: HTML attributes for the region <div>.
 * - region: The name of the region variable as defined in the theme's
 *   .info.yml file.
 *
 * @see template_preprocess_region()
 */
#}

{% set classes = [
  "header",
  "border-b",
  "border-black-200",
] %}

<div {{ attributes.addClass(classes) }}>
  <div class="header__start">
    <div class="header__mobile-trigger">
      {% embed 'icosaedrico:popover' with { popover_position: 'start' } %}
        {% block popover_trigger %}
          <span class="btn btn-ghost" aria-label="{{ 'Menú'|t }}">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" /></svg>
          </span>
        {% endblock %}
        {% block popover_content %}
          {{ content.main_menu__mobile }}
        {% endblock %}
      {% endembed %}
    </div>
    {{ content.icosaedrico_site_branding }}
  </div>
  <div class="header__center">
    {{ content.main_menu__desktop }}
    {{ content|without(
      'main_menu__mobile',
      'main_menu__desktop',
      'icosaedrico_site_branding',
      'icosaedrico_socialmenu',
      'icosaedrico_languageswitcherinterfacetext',
    ) }}
  </div>
  <div class="header__end">
    {{ content.icosaedrico_languageswitcherinterfacetext }}
    {{ content.icosaedrico_socialmenu }}
  </div>
</div>
