{#
/**
 * @file
 * Theme override for the front page (node 30).
 */
#}

<div class="page-wrapper frontpage">
  <header role="banner">
    {{ page.header }}
    {{ page.primary_menu }}
    {{ page.secondary_menu }}
  </header>

  <main role="main">
    <a id="main-content" tabindex="-1"></a>
    {{ page.content }}
  </main>

  {% include 'icosaedrico:site-footer' with {
    show_doodle: true,
    site_name: 'www.xacobe.net',
    logo_url: '/themes/custom/icosaedrico/logo_old.png',
    logo_alt: 'Logo',
    copyright_start_year: '2006'
  } %}

  {% if page.footer %}
    <div class="footer-region">
      {{ page.footer }}
    </div>
  {% endif %}
</div>
