{#
/**
 * @file
 * Theme override for the front page (node 30).
 */
#}

<div class="page-wrapper frontpage">
  <header role="banner">
    {{ page.header }}
    {{ page.primary_menu }}
    {{ page.secondary_menu }}
  </header>

  <main role="main">
    <a id="main-content" tabindex="-1"></a>

    <section class="frontpage__hero">
      {% include "icosaedrico:branding" with {
        branding_layout: "vertical",
        branding_size: "xl",
        branding_show_logo: true,
        branding_show_slogan: true,
      } %}
    </section>

    {{ page.content }}

  </main>

  <footer class="site-footer" role="contentinfo">
    {{ page.footer }}
  </footer>
</div>
