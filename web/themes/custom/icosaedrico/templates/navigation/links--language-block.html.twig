{#
/**
 * @file
 * Theme override for a set of links.
 * @see template_preprocess_links()
 */
#}
{% if links %}
  {% embed 'icosaedrico:popover' with { popover_position: 'end' } %}
    {% block popover_trigger %}
      {% include "icosaedrico:icon" with {
        icon_name: "translate",
        icon_svg_size: "20",
        icon_svg_fill: "currentColor",
      } only %}
    {% endblock %}
    {% block popover_content %}
      <ul>
        {% for item in links %}
          <li{{ item.attributes }}>
            {%- if item.link -%}
              {{ item.link }}
            {%- else -%}
              <span{{ item.text_attributes }}>{{ item.text }}</span>
            {%- endif -%}
          </li>
        {% endfor %}
      </ul>
    {% endblock %}
  {% endembed %}
{% endif %}
