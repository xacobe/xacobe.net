# =========================
# Sistema / OS
# =========================
.DS_Store
Thumbs.db

# =========================
# IDEs / Editores
# =========================
.vscode/
.idea/
*.swp
*.swo

# =========================
# Composer (dependencias)
# =========================
/vendor/
/web/core/
/web/vendor/

/web/*.php
/web/*.txt

/web/.eslintrc*
/web/.csslintrc

# ⚠️ IMPORTANTE:
# Normalmente NO ignoramos composer.lock en proyectos
# Si quieres reproducibilidad, comenta la siguiente línea:
# composer.lock

# =========================
# Drupal contrib (instalado vía Composer)
# =========================
/web/modules/*
!/web/modules/custom/

/web/profiles/*
!/web/profiles/custom/

/web/themes/*
!/web/themes/custom/

/web/sites/*.txt
/web/sites/example.*
/web/themes/*.txt

/web/example.gitignore
/web/sites/development.services.yml

/web/sites/*/files/translations/
/web/sites/*/files/oembed_thumbnails/
/web/sites/*/files/php/
/web/sites/*/files/languages/

# =========================
# Archivos sensibles
# =========================
/web/sites/default/settings.php
/web/sites/*/*.settings.php
/web/sites/*/*.services.yml

# =========================
# Archivos generados
# =========================
/web/sites/*/private/
/web/sites/*/files/styles/

# =========================
# Configuración local
# =========================
.env
.env.local
.env.*

# =========================
# Node / Frontend
# =========================
node_modules/
npm-debug.log
yarn-error.log
dist/
build/

# =========================
# Logs
# =========================
*.log

# =========================
# Testing / temporales
# =========================
/web/sites/simpletest/
/tmp/

# =========================
# Backups
# =========================
*.sql
*.tar.gz

# =========================
# DDEV (mantener config, ignorar runtime)
# =========================

# Ignoramos archivos generados
.ddev/.dbimageBuild/
.ddev/.webimageBuild/
.ddev/.global_commands/
.ddev/.downloaded_images/
.ddev/.ssh-agent/
.ddev/tmp/

# Ignoramos overrides locales
.ddev/docker-compose.*.yaml

# =========================
# PERMITIMOS configuración DDEV
# =========================
!.ddev/config.yaml
!.ddev/docker-compose.yaml
!.ddev/web-build/
!.ddev/db-build/
!.ddev/commands/